{
  "name": "farmer-codex",
  "private": true,
  "version": "0.1.0",
  "description": "Juego web de automatización agrícola programando drones con un DSL estilo Python.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.engine.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "sprites": "node scripts/generate-sprites.mjs",
    "atlas": "node scripts/build-atlas.mjs",
    "assets": "npm run sprites && npm run atlas"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "idb": "8.0.4",
    "pixi.js": "8.23.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "free-tex-packer-core": "0.3.9",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
